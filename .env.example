# Copy to .env.local and fill in one option. With none set, Lynkr runs in demo mode (templates, no AI).

# Option O: OpenAI (simplest). Set a monthly spend limit in your OpenAI dashboard first.
# OPENAI_API_KEY=
# LLM_MODEL=gpt-5-mini

# Option A: Anthropic
# ANTHROPIC_API_KEY=
# LYNKR_MODEL=claude-opus-5-5

# Option B: any OpenAI-compatible chat endpoint (OpenRouter, a local server, etc.)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=

# Optional: import one public job posting (Greenhouse, Lever, Ashby) via Apify. Server-only.
# Set a monthly spend limit in the Apify console too.
# APIFY_API_KEY=
# APIFY_ENABLED=0            # kill switch: uncomment to turn the import off
# APIFY_DAILY_CAP=100
# APIFY_PER_VISITOR_DAILY=5

# Paid access: Lynkr is a monthly subscription sold through Dodo Payments (Merchant of Record).
# With accounts on (below), people subscribe from their account; otherwise they get a license key by email from
# Dodo and enter it in the app. License keys keep working either way. Server-only keys below.
# The paywall is ON in production builds (Vercel) and OFF in local development.
# LYNKR_PAYWALL=0                     # force it off (e.g. a private demo); LYNKR_PAYWALL=1 forces it on locally
# DODO_PAYMENTS_API_KEY=              # Dodo API key for the matching environment, used to open checkout
# DODO_PRODUCT_ID=pdt_...             # the subscription product; license keys must belong to it
# DODO_ENVIRONMENT=live_mode          # required in production: Dodo's TEST environment is refused there, because
#                                     # anyone can create test-mode license keys with a test card
# LYNKR_ALLOW_TEST_PAYMENTS=1         # only for a preview deployment that should use Dodo test mode
# NEXT_PUBLIC_CONTACT_EMAIL=          # shown on the Terms, Privacy, Refunds and Contact pages (set before building)

# Accounts (sign up, sign in, subscription tied to the account). Off until DATABASE_URL and BETTER_AUTH_SECRET
# are set; without them the app uses license keys only. After setting them, run: npm run db:migrate
# DATABASE_URL=postgres://...          # Postgres, e.g. Neon (Vercel Marketplace), pooled. Accounts plus saved context (after db:migrate)
# DATABASE_URL_UNPOOLED=postgres://... # direct connection, used only by npm run db:migrate
# BETTER_AUTH_SECRET=                  # 32+ random characters: openssl rand -base64 32
# BETTER_AUTH_URL=https://www.lynkr.cloud   # the site's own address (used in email links and Google sign-in)
# RESEND_API_KEY=                      # sends confirmation, reset and sign-in emails (required in production)
# EMAIL_FROM="Lynkr <hello@lynkr.cloud>"    # a sender on a domain verified in Resend
# GOOGLE_CLIENT_ID=                    # optional: "Continue with Google". Redirect URI:
# GOOGLE_CLIENT_SECRET=                #   https://www.lynkr.cloud/api/auth/callback/google
# APPLE_CLIENT_ID=                     # optional: "Continue with Apple" (Services ID; needs a paid Apple Developer account)
# APPLE_CLIENT_SECRET=                 #   signed JWT, expires after at most 6 months. Return URL: https://www.lynkr.cloud/api/auth/callback/apple
# DODO_PAYMENTS_WEBHOOK_KEY=           # Dodo webhook secret. Webhook URL: https://www.lynkr.cloud/api/auth/dodopayments/webhooks
# LINKEDIN_CLIENT_ID=                  # optional: "Continue with LinkedIn" (scopes openid profile email). Redirect URI:
# LINKEDIN_CLIENT_SECRET=              #   https://www.lynkr.cloud/api/auth/callback/linkedin
# CRON_SECRET=                         # 16+ random characters; Vercel Cron sends it to /api/cron/cleanup (12-month inactivity cleanup)

# Interview version: v1 (old one-story interview) or v2 (question bank + Story Vault in the account).
# Default: v2 on Vercel preview builds, v1 in production and local runs.
# LYNKR_INTERVIEW=v1
# v2 makes the interview, Story Vault and first-win draft free with a signed-in account; everything else stays paid.

# Persona evaluation against a running server: node --no-warnings --import ./tests/register.mjs scripts/eval-personas.mts
# LYNKR_URL=http://localhost:3000
# LYNKR_COOKIE=                       # a signed-in session cookie, only when that server requires an account

# Force demo mode even when keys are set
# LYNKR_MOCK=1

# Best-effort per-visitor limits; the real cap is your provider's spend limit
# LYNKR_DAILY_CAP=400
