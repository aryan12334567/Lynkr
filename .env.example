# Copy to .env.local and fill in one option. With none set, Lynkr runs in demo mode (templates, no AI).

# Option A: Anthropic
# ANTHROPIC_API_KEY=
# LYNKR_MODEL=claude-opus-5-5

# Option B: any OpenAI-compatible chat endpoint (OpenRouter, a local server, etc.)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=

# Force demo mode even when keys are set
# LYNKR_MOCK=1

# Best-effort per-visitor limits; the real cap is your provider's spend limit
# LYNKR_DAILY_CAP=400
