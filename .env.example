# Lynkr environment variables. Names and what they do; never put a real value in this file.
# Local: copy to .env.local and fill in. Hosted: set them in the Render dashboard.
# With none set, the app runs in demo mode: template drafts, no accounts, no payments.

# ---- AI (one option; with none, drafts are demo templates and /api/status says mock: true) ----
# OpenAI. Model defaults to gpt-5-mini; LLM_MODEL overrides it.
OPENAI_API_KEY=
LLM_MODEL=
# Any OpenAI-compatible endpoint instead: all three are needed.
LLM_BASE_URL=
LLM_API_KEY=
# Anthropic instead. LYNKR_MODEL overrides the default model.
ANTHROPIC_API_KEY=
LYNKR_MODEL=
# "1" forces demo mode even when a key is set (tests and local demos).
LYNKR_MOCK=
# AI calls a day across all users before writing pauses until tomorrow (default 400).
LYNKR_DAILY_CAP=

# ---- Accounts and database ----
# Postgres (Neon). Production uses DATABASE_URL; DATABASE_URL_UNPOOLED is the direct connection for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Preview and local only: a separate Neon branch. When set it wins, so a preview can never reach production data.
LYNKR_DATABASE_URL=
LYNKR_DATABASE_URL_UNPOOLED=
# A long random string. Without it accounts are switched off. Also signs comment receipts and seals linked license keys.
BETTER_AUTH_SECRET=
# The site's own address, for example http://localhost:3000 or https://www.lynkr.cloud. Also decides canonical links
# and whether search engines may index the site (only https://www.lynkr.cloud is indexed).
BETTER_AUTH_URL=
# Optional separate secret for comment receipts (falls back to BETTER_AUTH_SECRET).
COMMENT_RECEIPT_SECRET=
# Sign-in providers. Each button appears only when both of its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ---- Email (sign-in codes, verification, password reset) ----
# Resend. Without it, a local run prints the link or code to the server log and a hosted site refuses to send.
RESEND_API_KEY=
# A sender on a domain verified in Resend, for example: Lynkr <noreply@lynkr.cloud>
EMAIL_FROM=
# Milliseconds to wait for the email service (default 10000).
LYNKR_EMAIL_TIMEOUT_MS=

# ---- Payments (Dodo) ----
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID=
# "live_mode" for real payments; anything else is test mode.
DODO_ENVIRONMENT=
# "1" lets a production build accept Dodo test payments. For the tester round only: remove it before charging anyone.
LYNKR_ALLOW_TEST_PAYMENTS=
# "1" on, "0" off (emergency or testers only). Unset: on in a production build, off in local development.
LYNKR_PAYWALL=
# "on" keeps access during Dodo's past-due retry window (decision D-I5).
LYNKR_PAST_DUE_GRACE=

# ---- Feature switches (unset: the new version on a preview, the old one everywhere else) ----
# v1 or v2
LYNKR_INTERVIEW=
LYNKR_OUTREACH=
LYNKR_CALENDAR=
# on or off
LYNKR_COMMENTER=
# Meeting notes in drafts (off unless exactly "on"; needs Aryan's answer to D-O3 first).
LYNKR_OUTREACH_NOTES_IN_DRAFTS=

# ---- Outreach ----
# Recipient search (Exa). Without it the brief says search is not connected yet and uses fixtures.
EXA_API_KEY=
# Searches per month across all users before search pauses (default 2000).
LYNKR_SEARCH_MONTHLY_CAP=
# Calendar feed reads per person per hour (default 600).
LYNKR_CALENDAR_PER_HOUR=

# ---- Chrome extension ----
# The extension's ID, pinned for CORS on /api/ext/*. Empty until the extension has a fixed ID.
LYNKR_EXT_ID=
# The same ID for the web app, so it can offer "Open in the extension" (build time).
NEXT_PUBLIC_LYNKR_EXT_ID=
# Extra site origins a tester build of the extension may talk to (used by npm run ext:build).
LYNKR_EXT_EXTRA_ORIGINS=

# ---- Job page import (Apify, optional) ----
APIFY_ENABLED=
APIFY_API_KEY=
APIFY_DAILY_CAP=
APIFY_PER_VISITOR_DAILY=

# ---- Housekeeping ----
# At least 16 characters. The 12-month cleanup at /api/cron/cleanup refuses to run without it.
CRON_SECRET=
# The contact address printed on Terms, Privacy, Refunds and Contact (build time).
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Analytics (optional) ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Microsoft Clarity and the Google Search Console token are public identifiers set in app/layout.tsx, not read from here.
# Posts: v1 or v2 (the per-post flow, scheduling and the Calendar's post items).
LYNKR_POSTS=
# Posts: "on" lets the server publish an approved text post to the person's own LinkedIn at its time (needs w_member_social). Anything else: nothing is ever sent.
LYNKR_AUTOPUBLISH=
# Posts: LinkedIn API version header, YYYYMM (a built-in default is used when empty).
LINKEDIN_API_VERSION=
