# Copy to .env.local and fill in one option. With none set, Lynkr runs in demo mode (templates, no AI).

# Option O: OpenAI (simplest). Set a monthly spend limit in your OpenAI dashboard first.
# OPENAI_API_KEY=
# LLM_MODEL=gpt-5-mini

# Option A: Anthropic
# ANTHROPIC_API_KEY=
# LYNKR_MODEL=claude-opus-5-5

# Option B: any OpenAI-compatible chat endpoint (OpenRouter, a local server, etc.)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=

# Optional: import one public job posting (Greenhouse, Lever, Ashby) via Apify. Server-only.
# Set a monthly spend limit in the Apify console too.
# APIFY_API_KEY=
# APIFY_ENABLED=0            # kill switch: uncomment to turn the import off
# APIFY_DAILY_CAP=100
# APIFY_PER_VISITOR_DAILY=5

# Paid access: Lynkr is a monthly subscription sold through Dodo Payments (Merchant of Record).
# Subscribers get a license key by email from Dodo and enter it in the app. Server-only keys below.
# The paywall is ON in production builds (Vercel) and OFF in local development.
# LYNKR_PAYWALL=0                     # force it off (e.g. a private demo); LYNKR_PAYWALL=1 forces it on locally
# DODO_PAYMENTS_API_KEY=              # Dodo API key for the matching environment, used to open checkout
# DODO_PRODUCT_ID=pdt_...             # the subscription product; license keys must belong to it
# DODO_ENVIRONMENT=live_mode          # required in production: Dodo's TEST environment is refused there, because
#                                     # anyone can create test-mode license keys with a test card
# LYNKR_ALLOW_TEST_PAYMENTS=1         # only for a preview deployment that should use Dodo test mode
# NEXT_PUBLIC_CONTACT_EMAIL=          # shown on the Terms, Privacy, Refunds and Contact pages (set before building)

# Force demo mode even when keys are set
# LYNKR_MOCK=1

# Best-effort per-visitor limits; the real cap is your provider's spend limit
# LYNKR_DAILY_CAP=400
