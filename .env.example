# Microsoft Clarity
# Get this from https://clarity.microsoft.com/
CLARITY_PROJECT_ID=z4fk3z8waa

# PostHog Analytics
# Get your API key from https://posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Google Analytics
# Verification token for Google Search Console
GOOGLE_SITE_VERIFICATION=D2FKxikgMBg1m6UZKzFROoJdya6hOau3b0hMkD-JayI

# Outreach v2 (names only; paste real values in the Render dashboard or .env.local, never here)
# v1 keeps today's Outreach and Connect tabs; v2 is the new workspace. Production stays v1 until released.
LYNKR_OUTREACH=v1
# Recipient search (Exa). Without it the brief says search is not connected yet and uses fixtures.
EXA_API_KEY=
# Searches per month across all users before search pauses (default 2000).
LYNKR_SEARCH_MONTHLY_CAP=
# Chrome extension ID, pinned for CORS on /api/ext/*. Empty until the extension has a fixed ID.
LYNKR_EXT_ID=
# Preview only: a separate Neon branch. A preview ignores DATABASE_URL, so it can never reach production data.
LYNKR_DATABASE_URL=
# Meeting notes in drafts (off unless exactly "on"; needs Aryan's answer to D-O3 first).
LYNKR_OUTREACH_NOTES_IN_DRAFTS=
